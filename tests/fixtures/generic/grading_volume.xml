<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic grading model. "Pad Earthworks" is a volume (depth) surface on the plane
     depth = (v - 10) / 5, where v is the second stored coordinate (0 to 20 m), over a 10 x 20 m pad: cut 100 m3, fill 100 m3, plan area 200 m2,
     cut and fill areas 100 m2 each. The extra hidden triangle must be ignored.
     "Pad FG" is the design: Pad EG (z = 100 + 0.1 u + 0.05 v) plus that depth, z = 98 + 0.1 u + 0.25 v,
     triangulated differently from Pad EG, so Pad FG minus Pad EG gives the same cut and fill. -->
<LandXML xmlns="http://www.landxml.org/schema/LandXML-1.2" version="1.2">
  <Units><Metric linearUnit="meter" verticalLinearUnit="meter" areaUnit="squareMeter" volumeUnit="cubicMeter"/></Units>
  <Surfaces>
    <Surface name="Pad EG">
      <Definition surfType="TIN">
        <Pnts><P id="1">0 0 100</P><P id="2">0 20 101</P><P id="3">10 20 102</P><P id="4">10 0 101</P></Pnts>
        <Faces><F>1 2 3</F><F>1 3 4</F></Faces>
      </Definition>
    </Surface>
    <Surface name="Pad FG">
      <Definition surfType="TIN">
        <Pnts><P id="1">0 0 98</P><P id="2">0 20 103</P><P id="3">10 20 104</P><P id="4">10 0 99</P><P id="5">3 12 101.3</P></Pnts>
        <Faces><F>1 2 5</F><F>2 3 5</F><F>3 4 5</F><F>4 1 5</F></Faces>
      </Definition>
    </Surface>
    <Surface name="Pad Earthworks">
      <Definition surfType="TIN">
        <Pnts>
          <P id="1">0 0 -2</P><P id="2">0 20 2</P><P id="3">10 20 2</P><P id="4">10 0 -2</P>
          <P id="5">5 7 -0.6</P><P id="6">0 30 4</P>
        </Pnts>
        <Faces>
          <F>1 2 5</F><F>2 3 5</F><F>3 4 5</F><F>4 1 5</F>
          <F i="1">2 6 3</F>
        </Faces>
      </Definition>
    </Surface>
  </Surfaces>
</LandXML>
